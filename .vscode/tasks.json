{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Spot",
            "type": "shell",
            "command": "xcodebuild",
            "args": [
                "-project",
                "Spot.xcodeproj",
                "-scheme",
                "Spot",
                "-configuration",
                "Debug",
                "-derivedDataPath",
                "build",
                "build"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Test SpotCore",
            "type": "shell",
            "command": "swift",
            "args": [
                "test",
                "--package-path",
                "SpotCore"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Check library against tonal",
            "type": "shell",
            "command": "python3",
            "args": [
                "-I",
                "SpotCore/Scripts/check_library.py"
            ],
            "problemMatcher": []
        }
    ]
}
